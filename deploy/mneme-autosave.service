# The autosave service for one wiki folder, as a systemd user unit.
#
# Put this machine's token in ~/.config/mneme/token with mode 0600, set the server's URL
# below, make the folder ready once with the same flags as ExecStart has:
#
#   mneme autosave init --folder ~/wiki --server URL --token-file ~/.config/mneme/token --name NAME
#
# then copy this file to ~/.config/systemd/user/ and run
#
#   systemctl --user enable --now mneme-autosave.service
#
# The machine's name defaults to the short host name, which must match the tokens file on
# the server.

[Unit]
Description=Mneme autosave for %h/wiki
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=%h/.local/bin/mneme autosave run --folder %h/wiki --server https://mneme.ts.notes.supply --token-file %h/.config/mneme/token --name %l
Restart=on-failure
RestartSec=10
# SIGTERM goes to the service alone, which finishes its tick, so the Git commands it started
# end on their own instead of being cut off.
KillMode=mixed
TimeoutStopSec=60

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/wiki
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
